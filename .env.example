# ══════════════════════════════════════════════════════════
# ram-adminx 环境变量配置 — 复制为 .env 后填写
# ══════════════════════════════════════════════════════════

# ── Django 核心 ──────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_SETTINGS_MODULE=config.settings.prod
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_DB=ramadminx
POSTGRES_USER=ramadminx
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://ramadminx:change-me-strong-password@db:5432/ramadminx

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ── CORS / CSRF ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ── SSL ─────────────────────────────────────────────────
SECURE_SSL_REDIRECT=true

# ── AI Provider Keys（按需启用）──────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

QCLAW_API_KEY=
QCLAW_BASE_URL=https://api.qclaw.ai/v1
QCLAW_MODEL=pool-deepseek-v4-pro

# ── AI 故障转移 ─────────────────────────────────────────
AI_FAILOVER_FAILURE_THRESHOLD=3
AI_FAILOVER_RECOVERY_TIMEOUT=60

# ── AI 审批流 ───────────────────────────────────────────
AI_APPROVAL_ENABLED=true
AI_APPROVAL_AUTO_EXECUTE=true
AI_APPROVAL_TIMEOUT_HOURS=24
AI_AGENT_TOKEN_SECRET=change-me-another-random-string

# ── AI 调用限制 ─────────────────────────────────────────
AI_RATE_LIMIT_PER_ROOT=100
AI_RATE_LIMIT_PER_AGENT=20
AI_TIMEOUT=30

# ── AI Mock 模式（生产环境建议关闭）────────────────────
AI_MOCK_WHEN_NO_KEY=false
