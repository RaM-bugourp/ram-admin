+def has_role(user, code: str) -> bool:
+    """Return whether a live user has the given RBAC role."""
+    if not user or not getattr(user, 'id', None):
+        return False
+    from apps.rbac.models import UserRole
+    return UserRole.objects.filter(user=user, role__code=code).exists()
+
+
+def boss_can_manage_user(actor, target) -> bool:
+    """BOSS may manage ordinary users, never root/BOSS identities."""
+    if not has_role(actor, 'boss') or getattr(actor, 'is_superuser', False):
+        return True
+    return not (
+        getattr(target, 'is_superuser', False)
+        or has_role(target, 'root')
+        or has_role(target, 'boss')
+    )
+
+
+def boss_can_assign_roles(actor, role_ids) -> bool:
+    """Prevent BOSS from granting root/BOSS privileges to any account."""
+    if not has_role(actor, 'boss') or getattr(actor, 'is_superuser', False):
+        return True
+    from apps.rbac.models import Role
+    return not Role.objects.filter(id__in=list(role_ids or []), code__in={'root', 'boss'}).exists()
